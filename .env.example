# Server-only CallTrackingMetrics FormReactor credentials.
# Do not prefix these with PUBLIC_ — they must never ship to the browser.
# Rotate the key in CTM if it has ever appeared in git or built HTML.

CTM_FORMREACTOR_ENDPOINT=https://api.calltrackingmetrics.com/api/v1/formreactor/YOUR_REACTOR_ID
CTM_FORMREACTOR_KEY=replace-me

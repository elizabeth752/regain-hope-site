{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; font-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.googletagmanager.com https://*.tctm.co https://*.calltrackingmetrics.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.googletagmanager.com https://*.google.com https://*.g.doubleclick.net https://*.tctm.co https://*.calltrackingmetrics.com; frame-src https://www.google.com https://www.googletagmanager.com https://maps.google.com https://*.tctm.co"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    { "source": "/about", "destination": "/about-us/", "permanent": true },
    { "source": "/why-us", "destination": "/about-us/", "permanent": true },
    { "source": "/services", "destination": "/programs/", "permanent": true },
    { "source": "/services-7", "destination": "/programs/", "permanent": true },
    { "source": "/contact-9", "destination": "/contact/", "permanent": true },
    { "source": "/insurance-verification", "destination": "/admissions/verify-insurance/", "permanent": true },
    { "source": "/sms-terms-and-conditions", "destination": "/sms-terms/", "permanent": true },
    { "source": "/privacy-notice-for-california-residents", "destination": "/your-privacy-choices/", "permanent": true },
    { "source": "/cookie-policy", "destination": "/privacy/", "permanent": true },
    { "source": "/consumer-health-data-privacy-policy", "destination": "/privacy/", "permanent": true },
    { "source": "/gallery", "destination": "/", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/blog/chronic-alcoholism-signs-and-treatment", "destination": "/blog/alcohol-blackout-what-is-it-and-why-does-it-happen/", "permanent": true },
    { "source": "/blog/chronic-alcoholism-signs-and-treatment/", "destination": "/blog/alcohol-blackout-what-is-it-and-why-does-it-happen/", "permanent": true }
  ]
}

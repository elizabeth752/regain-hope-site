---
// Compact reviews module — reusable between text sections on detail pages
import { featuredReviews, googleUrl as GBP, googleRating } from '../data/reviews.js';
---
<section class="bg-cream"><div class="container">
  <div class="sec-head"><span class="eyebrow">Reviews</span><h2>Rated {googleRating} on Google</h2></div>
  <div class="reviews">
    {featuredReviews.map((r) => (
      <div class="review"><div class="stars">★★★★★</div><p>"{r.short}"</p><div class="who">{r.name}</div></div>
    ))}
  </div>
  <div class="reviews-cta"><a href={GBP} target="_blank" rel="noopener" class="btn btn-outline">See all reviews on Google →</a></div>
</div></section>

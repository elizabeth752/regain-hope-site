---
// Reviews wall — full review text, all reviews, masonry columns so variable-length
// cards pack tightly with no ragged white space. Copy lives in src/data/reviews.js.
import { reviews, googleUrl as GBP, googleRating, googleReviewCount } from '../data/reviews.js';
export interface Props { bg?: 'white' | 'cream'; }
const { bg = 'white' } = Astro.props;
const score = `${googleRating} · ${googleReviewCount} reviews`;
---
<section class={bg === 'cream' ? 'bg-cream' : ''}><div class="container">
  <div class="sec-head"><span class="eyebrow">Reviews</span><h2>Rated {googleRating} on Google</h2><p><span style="color:var(--star);letter-spacing:2px;">★★★★★</span>&nbsp;&nbsp;{score}</p></div>
  <div class="revwall">
    {reviews.map((r) => (
      <figure class="rev">
        <div class="stars">★★★★★</div>
        <blockquote>“{r.text}”</blockquote>
        <figcaption class="who"><span class="ava">{r.initial}</span><span class="nm">{r.name}<small>Posted on Google · {r.posted}</small></span></figcaption>
      </figure>
    ))}
    <a class="rev rev-cta" href={GBP} target="_blank" rel="noopener" aria-label="Read all reviews on Google">
      <span class="rc-g">G</span>
      <div class="stars">★★★★★</div>
      <div class="rc-score">{score}</div>
      <span class="rc-link">Read all reviews on Google →</span>
    </a>
  </div>
</div></section>

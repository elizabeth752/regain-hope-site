---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import heroImg from '../assets/hero-regain-03.jpg';
// Sitewide hero. LCP media is a real <picture> (AVIF/WebP), not a CSS background.
//   variant="form"    → money pages: insurance verify form on the right
//   variant="reviews" → everything else: rotating 5-star review spotlight on the right
export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  byline?: string;
  bylineHref?: string;
  chips?: string[];
  variant?: 'form' | 'reviews';
  cta?: { label: string; href: string };
}
const {
  eyebrow, title, lead, byline, bylineHref = '/about-us/team/',
  chips = [], variant = 'reviews',
  cta = { label: 'Verify Your Insurance', href: '/admissions/verify-insurance/' },
} = Astro.props;

const reviews = [
  { text: 'The two doctors are genuinely caring and compassionate. In past detoxes I often felt treated like a number. Here they truly make you feel valued and cared for as a person.', who: 'Chris' },
  { text: 'Dr. Gomez and Dr. Carlos are incredible. They make the house feel like home and family, and Dr. Gomez genuinely cares, following up with clients even after discharge.', who: 'Jimmy' },
  { text: "They didn't make the facility feel cold or clinical. They made it feel like home. You could tell they genuinely cared about the people there.", who: 'Ashlie L.' },
];
const GBP = 'https://maps.app.goo.gl/S3YvacbqJG8mVm457';
---
<section class={`hero hero--${variant}`}>
  {/* LCP element: eager + fetchpriority high. Decorative for a11y (copy is in the H1). */}
  <Picture
    src={heroImg}
    formats={['avif', 'webp']}
    widths={[480, 720, 960, 1200]}
    sizes="100vw"
    width={1200}
    height={800}
    quality={45}
    alt=""
    role="presentation"
    class="hero-media"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-inner">
      {eyebrow && <span class="eyebrow" style="color:#fff">{eyebrow}</span>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      {byline && <p class="byline">Medically reviewed by <a href={bylineHref}>{byline}</a></p>}
      {chips.length > 0 && (
        <ul class="hero-points">
          {chips.map((c) => <li><span class="hp-ic"><Icon name="check" size={15} /></span>{c}</li>)}
        </ul>
      )}
      <p class="hero-talk" style="margin-top:22px;">Prefer to talk? <a href="tel:+18182644388" class="hero-phone-link">Call 24/7: (818) 264-4388</a></p>
    </div>

    {variant === 'form' ? (
      <div class="hero-form-wrap">
        <form class="hero-form" action="/api/lead/" method="post">
          <img class="form-hipaa" src="/images/logos/hipaa.svg" alt="" width="64" height="36" loading="lazy" decoding="async" />
          <h3>Verify Your Insurance</h3>
          <p class="fsub">Free and confidential. Leave your name and number and we'll call you right back to check your coverage. Most PPO plans accepted. Policy ID is optional — we can collect it by phone.</p>
          <div class="hp" aria-hidden="true">
            <input name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="frow">
            <div><label for="nm">Full name</label><input id="nm" name="name" autocomplete="name" required /></div>
            <div><label for="ph">Phone</label><input id="ph" name="phone" type="tel" autocomplete="tel" required /></div>
          </div>
          <div class="frow">
            <div>
              <label for="ic">Insurance carrier</label>
              <select id="ic" name="insurance_carrier" required>
                <option value="" disabled selected>Select carrier</option>
                <option>Aetna</option>
                <option>Cigna</option>
                <option>Blue Cross Blue Shield</option>
                <option>UnitedHealthcare</option>
                <option>Anthem</option>
                <option>Kaiser</option>
                <option>Humana</option>
                <option>Health Net</option>
                <option>TRICARE</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label for="pid">Policy / Member ID <span class="optional">(optional)</span></label>
              <input id="pid" name="policy_id" autocomplete="off" inputmode="text" maxlength="40" />
            </div>
          </div>
          <label class="optin"><input type="checkbox" name="sms_consent" value="1" required style="width:auto;margin:2px 0 0;" /> <span>I agree to receive calls/texts from Regain Hope Detox and Recovery Center about treatment. Msg &amp; data rates may apply. Reply STOP to opt out. Consent is not a condition of treatment.</span></label>
          <p class="form-error" hidden role="alert"></p>
          <button type="submit">Request My Callback</button>
          <p class="hipaa">Your information is private and confidential. We do not send policy IDs to advertising tools.</p>
        </form>
      </div>
    ) : (
      <div class="hero-rev" data-rotate>
        <div class="hr-badge"><span class="stars">★★★★★</span> 5.0 on Google · 8 reviews</div>
        <div class="hr-stage">
          {reviews.map((r, i) => (
            <article class={`hrev${i === 0 ? ' active' : ''}`}>
              <div class="stars">★★★★★</div>
              <p>“{r.text}”</p>
              <div class="who">{r.who}</div>
            </article>
          ))}
        </div>
        <div class="hr-foot">
          <a class="btn btn-gold" href={cta.href}>{cta.label}</a>
          <a class="hr-all" href={GBP} target="_blank" rel="noopener">See all reviews →</a>
        </div>
      </div>
    )}
  </div>
</section>

{/* Review rotation only — form handler is deferred and only needed when a form exists */}
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-rotate]').forEach((box) => {
    const items = Array.from(box.querySelectorAll('.hrev'));
    if (items.length < 2 || reduce) return;
    let i = 0;
    setInterval(() => {
      items[i].classList.remove('active');
      i = (i + 1) % items.length;
      items[i].classList.add('active');
    }, 5000);
  });
</script>

{variant === 'form' && (
  <script>
    // Lead capture via first-party /api/lead/ (CTM credentials stay on the server).
    document.querySelectorAll('form.hero-form').forEach((f) => {
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = f.querySelector('button[type="submit"]');
        const errEl = f.querySelector('.form-error');
        const showError = (msg) => {
          if (errEl) { errEl.hidden = false; errEl.textContent = msg; }
          if (btn) { btn.disabled = false; btn.textContent = 'Request My Callback'; }
        };
        if (errEl) { errEl.hidden = true; errEl.textContent = ''; }
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

        const data = new FormData(f);
        const qs = new URLSearchParams(window.location.search);
        const attribution = {};
        const map = { gclid: 'gclid', campaign_id: 'utm_campaign', adgroup_id: 'utm_content', creative_id: 'utm_term', form_id: 'utm_source' };
        Object.entries(map).forEach(([ctmKey, param]) => {
          const v = qs.get(param);
          if (v) attribution[ctmKey] = v;
        });

        try {
          const res = await fetch('/api/lead/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              name: data.get('name') || '',
              phone: data.get('phone') || '',
              insurance_carrier: data.get('insurance_carrier') || '',
              policy_id: data.get('policy_id') || '',
              company_website: data.get('company_website') || '',
              consent: data.get('sms_consent') === '1',
              attribution,
            }),
          });
          const payload = await res.json().catch(() => ({}));
          if (!res.ok || !payload.ok) {
            showError(payload.error || 'We could not send your request. Please call (818) 264-4388.');
            return;
          }
          window.location.href = '/thank-you/';
        } catch (_) {
          showError('We could not send your request. Check your connection or call (818) 264-4388.');
        }
      });
    });
  </script>
)}

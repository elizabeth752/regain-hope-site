---
// Shows the Notice of Privacy Practices until the client approves the text of a separate website privacy policy;
// then that text replaces <NoticeOfPrivacyPractices /> here and the notice stays on its own page.
import Layout from '../layouts/Layout.astro';
import NoticeOfPrivacyPractices from '../components/NoticeOfPrivacyPractices.astro';
---
<Layout title="Privacy Policy | Regain Hope Detox and Recovery Center" description="Notice of Privacy Practices for Regain Hope Detox and Recovery Center: how we use and protect your health information under HIPAA and 42 C.F.R. Part 2." noindex={true}>
  <section class="minihero"><div class="container">
    <span class="eyebrow">Legal</span>
    <h1>Notice of Privacy Practices</h1>
    <p>Effective August 4, 2026</p>
  </div></section>
  <section><div class="container rich" style="max-width:820px;">
    <NoticeOfPrivacyPractices />
  </div></section>
</Layout>

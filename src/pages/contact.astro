---
import Layout from '../layouts/Layout.astro';
import MapEmbed from '../components/MapEmbed.astro';
const pageSchema = { '@context': 'https://schema.org', '@type': 'MedicalClinic', name: 'Regain Hope Detox and Recovery Center', address: { '@type': 'PostalAddress', streetAddress: '1134 N Lima St', addressLocality: 'Burbank', addressRegion: 'CA', postalCode: '91505', addressCountry: 'US' }, telephone: '+1-818-239-7045', email: 'info@regainhopedetox.com', geo: { '@type': 'GeoCoordinates', latitude: 34.1719189, longitude: -118.3451238 } };
---
<Layout
  title="Contact Us | Regain Hope Detox and Recovery Center"
  description="Contact Regain Hope Detox and Recovery Center in Burbank, CA. Call us at (818) 264-4388, verify your insurance, or send us a message. Confidential and judgment-free."
  schema={pageSchema}
>
  <section class="minihero"><div class="container">
    <span class="eyebrow">Confidential</span>
    <h1>Contact Regain Hope Detox and Recovery Center</h1>
    <p>Whether you're ready to start or just have questions, we're here, confidential, judgment-free, no pressure. We also speak Spanish and Korean.</p>
  </div></section>

  <section><div class="container"><div class="loc">
    <div class="rich">
      <h2>Reach us</h2>
      <ul>
        <li><b>Admissions:</b> <a href="tel:+18182644388">(818) 264-4388</a></li>
        <li><b>Hours:</b> residential care 24/7. Admissions calls are answered 7 days a week; after hours, leave a voicemail and our team will call you back.</li>
        <li><b>Address:</b> 1134 N. Lima St., Burbank, CA 91505</li>
        <li><b>Email:</b> <a href="mailto:info@regainhopedetox.com">info@regainhopedetox.com</a></li>
      </ul>
      <p style="margin-top:8px;"><b>Quick links:</b> <a href="/admissions/verify-insurance/">Verify your insurance</a> · <a href="/admissions/">How admission works</a></p>
      <div class="callout" style="margin-top:18px;">In crisis? Call or text <b>988</b> (Suicide &amp; Crisis Lifeline) or <b>911</b>. See our <a href="/crisis-resources/" style="color:var(--caoba);font-weight:700;">crisis resources</a>.</div>
    </div>
    <MapEmbed title="Map to Regain Hope Detox and Recovery Center" />
  </div></div></section>

  <section class="ctaband"><div class="container">
    <h2>Reaching out is the hardest step</h2>
    <p>Whatever you say is confidential, and there's no obligation, just a conversation with people who care.</p>
    <div class="hero-cta" style="justify-content:center;"><a href="tel:+18182644388" class="btn btn-gold">📞 Call us: (818) 264-4388</a></div>
  </div></section>
</Layout>

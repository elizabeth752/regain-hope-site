---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import heroSrc from '../assets/hero-regain-03.jpg';

export interface Props {
  title: string;
  description: string;
  /** Page-specific JSON-LD (e.g. FAQPage, MedicalWebPage). Object or array. */
  schema?: Record<string, any> | Record<string, any>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, schema, image = '/images/regain-05.jpeg', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// Responsive LCP preload — mobile gets a small WebP, not the desktop candidate
const heroLcpWidths = [640, 960, 1280];
const heroLcpVariants = await Promise.all(
  heroLcpWidths.map((width) =>
    getImage({ src: heroSrc, width, format: 'webp', quality: 68 })
  )
);
const heroLcpSrcset = heroLcpVariants
  .map((img, i) => `${img.src} ${heroLcpWidths[i]}w`)
  .join(', ');

// Sitewide Organization / Local business schema — rendered on every page
const org = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Regain Hope Detox and Recovery Center',
  url: 'https://www.regainhopedetox.com',
  telephone: '+1-818-264-4388',
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1134 N Lima St',
    addressLocality: 'Burbank',
    addressRegion: 'CA',
    postalCode: '91505',
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 34.1719189, longitude: -118.3451238 },
  medicalSpecialty: 'Addiction',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '5.0', reviewCount: '8' },
  knowsLanguage: ['English', 'Spanish', 'Korean'],
};

const jsonld = [org, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="generator" content={Astro.generator} />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Regain Hope Detox and Recovery Center" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- LCP: responsive WebP preload (imagesrcset picks the right size on mobile) -->
  <link
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={heroLcpSrcset}
    imagesizes="100vw"
    fetchpriority="high"
  />

  <!-- Fonts: only preload faces that paint above-the-fold (avoid competing with LCP) -->
  <link rel="preload" href="/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  <!-- GTM: deferred until interaction or idle — cuts TBT/main-thread contention on desktop -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    (function () {
      var loaded = false;
      function loadGTM() {
        if (loaded) return;
        loaded = true;
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var j = document.createElement('script');
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-NRM7J7XP';
        document.head.appendChild(j);
      }
      var opts = { once: true, passive: true };
      ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (evt) {
        window.addEventListener(evt, loadGTM, opts);
      });
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGTM, { timeout: 3500 });
      } else {
        setTimeout(loadGTM, 3500);
      }
    })();
  </script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NRM7J7XP" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <!-- Floating Google reviews badge (sitewide, bottom-left) -->
  <a class="grbadge" href="https://maps.app.goo.gl/S3YvacbqJG8mVm457" target="_blank" rel="noopener" aria-label="Rated 5.0 on Google from 8 reviews">
    <span class="g">G</span>
    <span class="grtxt"><span class="grstars">★★★★★</span><b>5.0</b> · 8 reviews</span>
  </a>

  <!-- Mobile marquees: run after first paint / idle to avoid CLS during LCP window -->
  <script>
    const bootMarquee = () => {
      const isMobile = window.matchMedia('(max-width:760px)').matches;
      const reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
      if (!isMobile || reduce) return;
      document.querySelectorAll('.trust .container, .ins-strip').forEach((el) => {
        if (el.dataset.mq) return;
        el.dataset.mq = '1';
        const track = document.createElement('div');
        track.className = 'mq-track';
        while (el.firstChild) track.appendChild(el.firstChild);
        const clone = track.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        clone.classList.add('mq-clone');
        const move = document.createElement('div');
        move.className = 'mq-move';
        move.appendChild(track);
        move.appendChild(clone);
        el.appendChild(move);
        el.classList.add('mq');
        el.querySelectorAll('img').forEach((img) => {
          if (img.complete && img.naturalWidth) return;
          const src = img.getAttribute('src');
          img.removeAttribute('loading');
          if (src) img.setAttribute('src', src);
        });
      });
    };

    const schedule = () => {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(bootMarquee, { timeout: 2500 });
      } else {
        setTimeout(bootMarquee, 1);
      }
    };

    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });
  </script>
</body>
</html>
